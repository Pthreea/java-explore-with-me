{
  "info": {
    "name": "Feature: Location Processing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Admin: Create Location",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/admin/locations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Парк Горького\",\n  \"lat\": 55.7312,\n  \"lon\": 37.6018,\n  \"description\": \"Центральный парк культуры и отдыха\",\n  \"radius\": 500.0\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has id\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.exist;",
              "    pm.environment.set(\"locationId\", jsonData.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin: Get Location by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/locations/{{locationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response has name\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql(\"Парк Горького\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin: Update Location",
      "request": {
        "method": "PATCH",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/admin/locations/{{locationId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Обновлённое описание парка\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Public: Get All Locations",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/locations"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Response is array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Public: Search Locations by Text",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/locations?text=Парк"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Found locations contain 'Парк'\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.be.above(0);",
              "    pm.expect(jsonData[0].name).to.include(\"Парк\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Public: Get Location by ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/locations/{{locationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin: Delete Location",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/admin/locations/{{locationId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}